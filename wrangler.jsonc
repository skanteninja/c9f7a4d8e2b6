{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maplestory-classic",
  "main": "worker.js",
  "compatibility_date": "2026-09-02",
  "durable_objects": {
    "bindings": [{"name":"MARKET","class_name":"MarketListings"}]
  },
  "migrations": [{"tag":"market-v1","new_sqlite_classes":["MarketListings"]}],
  "assets": {
    "directory": "./site",
    "binding": "ASSETS"
  }
}
